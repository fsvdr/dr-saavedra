---
import Footer from '../components/Footer.astro';
import PostHog from '../components/posthog.astro';
import Seo, { type OpenGraph } from '../components/Seo.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';
import '../styles/typeface-greycliff.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  og?: OpenGraph;
  isHome?: boolean;
}

const { title, description, canonical, image, imageAlt, og, isHome = false } = Astro.props;
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover" />
    <meta name="theme-color" content="#329f87" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Artículos médicos del Dr. Saavedra"
      href="/rss.xml"
    />

    <Seo {title} {description} {canonical} {image} {imageAlt} {og} />
    <PostHog />

    <script is:inline defer data-domain="drsaavedra.mx" src="https://plausible.io/js/script.js"></script>
    <script is:inline src="https://cdn.usefathom.com/script.js" data-spa="auto" data-site="JGUBFEOA" defer></script>

    <script is:inline>
      // Avoid FOIT: swap to the custom font only once it is ready.
      if ('fonts' in document) {
        Promise.all([
          document.fonts.load('400 1rem "Greycliff CF"'),
          document.fonts.load('500 1rem "Greycliff CF"'),
          document.fonts.load('600 1rem "Greycliff CF"'),
          document.fonts.load('italic 400 1rem "Greycliff CF"'),
          document.fonts.load('italic 500 1rem "Greycliff CF"'),
          document.fonts.load('italic 600 1rem "Greycliff CF"'),
        ]).then(() => document.body.classList.add('has-custom-font'));
      }
    </script>
  </head>

  <body>
    <SiteNav showInternalLinks={isHome} />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
