---
import Title from '../components/Title.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada — Dr. Benito Saavedra Alvarado">
  <div class="not-found">
    <span>404</span>
    <Title tabindex={0}>
      La página que solicitaste no existe pero no te preocupes, aquí hay algunos links que te pueden ayudar
    </Title>

    <div class="not-found__links">
      <a href="/" aria-label="Página principal">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon" focusable="false" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
        </svg>
        Página principal
      </a>

      <a href="/#articulos" aria-label="Artículos médicos">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon" focusable="false" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
        </svg>
        Artículos Médicos
      </a>
    </div>
  </div>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-flow: column nowrap;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 32rem);
    text-align: center;
    padding-block-start: 4rem;
    margin-block-end: 4rem;
  }

  .not-found > span {
    align-self: center;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 12rem;
    font-weight: var(--font-weight-demi-bold);
    inline-size: 30rem;
    block-size: 30rem;
    background-color: var(--color-accent);
    border-radius: 50%;
    margin-block-end: 4rem;
  }

  .not-found :global(.title) {
    max-width: 80rem;
    padding-inline-start: 2.4rem;
    padding-inline-end: 2.4rem;
    margin-block-end: 4rem;
  }

  .not-found__links {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    justify-content: center;
  }

  .not-found__links a {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
  }

  .not-found__links a:first-of-type {
    margin-inline-end: 1.6rem;
  }

  .not-found__links svg {
    margin-inline-end: 1.6rem;
    transition: color 0.3s;
  }

  .not-found__links a:hover svg {
    color: var(--color-accent);
  }
</style>
