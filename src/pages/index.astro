---
import { Image } from 'astro:assets';
import DistanceToLocation from '../components/DistanceToLocation.astro';
import PostCard from '../components/PostCard.astro';
import Testimonial from '../components/Testimonial.astro';
import Title from '../components/Title.astro';
import imss from '../images/imss.png';
import issste from '../images/issste.png';
import portrait from '../images/portrait.png';
import unam from '../images/unam.png';
import Layout from '../layouts/Layout.astro';
import { getLatestPosts, getTestimonials, sanityFetch } from '../lib/sanity';

const POSTS_PER_PAGE = 5;
const [posts, testimonials, totalPosts] = await Promise.all([
  getLatestPosts(POSTS_PER_PAGE),
  getTestimonials(10),
  sanityFetch<number>('count(*[_type == "blogPost" && defined(slug.current)])', 0),
]);
const pageCount = Math.max(1, Math.ceil(totalPosts / POSTS_PER_PAGE));
---

<Layout isHome>
  <section class="section hero" aria-label="Principal">
    <Title>
      Médico especialista en traumatología <wbr />y ortopedia. <wbr />
      Cirugía de rodilla, artroscopia y reemplazos articulares.
    </Title>

    <div class="portrait">
      <p aria-label="Cédula Profesional 987510">Cédula 987510</p>

      <div class="portrait__image">
        <Image src={portrait} alt="" widths={[400, 600, 800]} sizes="(min-width: 768px) 40rem, 100vw" aria-hidden="true" />
      </div>
    </div>

    <div class="office">
      <div class="office__card" aria-labelledby="office-location">
        <span>Consulta Privada</span>
        <address aria-label="Consulta privada">
          <a href="https://goo.gl/maps/WAgbfa7Pdip47SVK6" target="_blank" rel="noopener noreferrer" aria-label="Ubicación del consultorio en Google Maps" data-office-location-link>
            HMG Hospital Coyoacán, Consultorio 512
          </a>
        </address>

        <p class="sr-only" aria-hidden="true" id="office-location">
          Consulta privada en HMG Hospital Coyoacán, Consultorio 512
        </p>
      </div>

      <div class="office__address">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon--offset-size" focusable="false" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
          <circle cx="12" cy="10" r="3" />
        </svg>

        <div>
          <address aria-label="Dirección del hospital">
            División del Norte #3395, Colonia El Rosario, Ciudad de México
          </address>

          <DistanceToLocation />
        </div>
      </div>
    </div>
  </section>

  <section class="section experience" aria-label="Experiencia">
    <Title as="h2">Una carrera respaldada por las principales instituciones del país</Title>

    <div>
      <div class="work">
        <Image src={unam} alt="" width={80} densities={[1, 2]} aria-hidden="true" />
        <p>Licenciatura y especialización por parte de la UNAM</p>
      </div>
      <div class="work">
        <Image src={imss} alt="" width={80} densities={[1, 2]} aria-hidden="true" />
        <p>28 años de servicio en el Hospital Regional 2</p>
      </div>
      <div class="work">
        <Image src={issste} alt="" width={80} densities={[1, 2]} aria-hidden="true" />
        <p>28 años de servicio en el Hospital General Ignacio Zaragoza</p>
      </div>
    </div>
  </section>

  <section class="section about" aria-label="Acerca de">
    <div class="about__message">
      <Title as="h2">
        ¡Hola! Soy el Dr. Benito Saavedra, especialista en ortopedia y traumatología. Enfocado durante muchos años a
        las enfermedades de rodilla.
      </Title>

      <p>
        Mi especialidad se encarga de atender enfermedades degenerativas o traumáticas del sistema músculo
        esquelético.
      </p>
      <p>
        Mi objetivo principal es darle el tratamiento adecuado a las enfermedades del paciente, siendo responsable y
        honesto.
      </p>
      <p>Te invito a visitarme para ayudarte a tratar tu enfermedad. ¡Espero ser digno de tu confianza!</p>
    </div>

    <div class="about__services">
      <Title as="h3">Especialidades del Dr. Saavedra:</Title>

      <ul>
        <li>Artroscopia de hombro y rodilla</li>
        <li>Colocación de prótesis de cadera y rodilla</li>
      </ul>

      <div class="about__conditions">
        <Title as="h3">Algunas de las enfermedades y condiciones con las que te puedo ayudar:</Title>

        <ul>
          <li>Cervicalgias</li>
          <li>Codo de tenista</li>
          <li>Dedos en gatillo de mano</li>
          <li>Desgaste articular o artrosis de cadera</li>
          <li>Desgaste articular o artrosis de hombro</li>
          <li>Desgaste o Artrosis de rodilla</li>
          <li>Enfermedades de la columna vertebral</li>
          <li>Enfermedades del mango rotador en hombro</li>
          <li>Espolón calcáneo</li>
          <li>Fracturas y luxaciones de hombro, codo, muñeca, cadera, rodilla, tobillo y pie</li>
          <li>Lesiones de ligamentos de rodilla</li>
          <li>Lesiones de meniscos</li>
          <li>Lumbalgias</li>
          <li>Osteoartritis</li>
          <li>Pie plano</li>
          <li>Pinzamiento de hombro</li>
          <li>Sinovitis</li>
          <li>Túnel del carpo</li>
        </ul>
      </div>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section testimonials" id="testimonios" aria-label="Testimonios">
        <Title as="h2">
          Confianza que se traduce en trato humano, profesional y respetuoso asi como transparencia en todo momento
        </Title>

        <div class="testimonials__wrapper">
          {testimonials.map((testimonial) => (
            <Testimonial testimonial={testimonial} />
          ))}
        </div>
      </section>
    )
  }

  <section class="section blog" id="articulos" aria-label="Artículos">
    <Title as="h2">Procedimientos quirúrgicos explicados por el Dr. Saavedra</Title>

    <div class="blog__index">
      {posts.map((post) => <PostCard post={post} />)}

      <div class="blog__pagination">
        <p>Se muestra la página 1 de {pageCount}</p>

        <a href="/rss.xml" target="_blank" rel="noopener noreferrer" aria-label="Archivo RSS de los artículos médicos">
          Feed RSS
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelector<HTMLAnchorElement>('[data-office-location-link]')?.addEventListener('click', () => {
    window.posthog?.capture('office_location_opened');
  });
</script>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: min(100%, 60rem);
    grid-template-rows: auto auto auto;
    grid-template-areas:
      'title'
      'portrait'
      'office-info';
    grid-row-gap: 1.6rem;
    justify-content: center;
    justify-items: center;
    margin-block-end: 8rem;
  }

  .hero :global(.title) {
    grid-area: title;
  }

  /* Portrait */
  .portrait {
    grid-area: portrait;
    display: flex;
    flex-flow: column nowrap;
    width: min(100%, 40rem);
  }

  .portrait > p {
    align-self: flex-end;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    width: 6rem;
    height: 6rem;
    font-size: var(--font-size-xs);
    color: rgb(34, 34, 34);
    background-color: var(--color-accent);
    border-radius: 50%;
    margin-inline-end: 2.5%;
    margin-block-end: -3rem;
  }

  .portrait__image {
    position: relative;
    isolation: isolate;
    margin-block-start: 4rem;
  }

  .portrait__image::before {
    content: '';
    position: absolute;
    top: -4rem;
    left: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    background-color: var(--color-accent);
    border-radius: 50%;
  }

  .portrait__image :global(img) {
    position: relative;
    z-index: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  .portrait__image::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 1;
    width: 100%;
    height: 20%;
    box-shadow: inset 0 -32px 16px 8px var(--color-sand);
  }

  /* Office */
  .office {
    grid-area: office-info;
    max-width: 50rem;
  }

  .office__card {
    display: flex;
    flex-flow: column nowrap;
    font-weight: var(--font-weight-demi-bold);
    padding: 1.6rem;
    background-color: var(--color-white);
    border-radius: 8px;
    border-left: 0.8rem solid var(--color-accent);
    margin-block-end: 1.6rem;
  }

  .office__card span {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    margin-block-end: -0.4rem;
  }

  .office__address {
    display: flex;
    flex-flow: row nowrap;
    align-items: flex-start;
    font-size: var(--font-size-sm);
    padding-inline-start: 0.8rem;
    padding-inline-end: 0.8rem;
    margin-block-end: 2.4rem;
  }

  .office__address > svg {
    font-weight: var(--font-weight-demi-bold);
    margin-inline-end: 2.4rem;
    margin-block-start: 0.4rem;
  }

  .office__address > div {
    flex: 1 1 0;
  }

  .office__address address {
    font-style: normal;
    margin-block-end: 0.8rem;
  }

  /* Experience */
  section.experience {
    inline-size: 95%;
    background-color: var(--color-white);
    margin-block-end: 8rem;
  }

  .experience :global(.title) {
    padding-inline-start: 1.6rem;
    margin-block-end: 4rem;
  }

  .work {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    font-size: var(--font-size-sm);
    padding-inline-start: 2rem;
    padding-inline-end: 2rem;
    margin-block-end: 4rem;
  }

  .work:last-child {
    margin-block-end: 0;
  }

  .work p {
    flex: 1 1 0;
    margin-inline-start: 2rem;
    margin-block-end: 0;
  }

  /* About */
  section.about {
    margin-block-end: 8rem;
    padding-inline-start: 0;
    padding-inline-end: 0;
  }

  .about__message {
    padding-inline-start: calc(var(--inline-inset) + 2rem);
    padding-inline-end: calc(var(--inline-inset) + 2rem);
    margin-block-end: 8rem;
  }

  .about__message :global(.title) {
    position: relative;
    margin-block-end: 4rem;
  }

  .about__message :global(.title)::before {
    content: '"';
    position: absolute;
    top: 1.6rem;
    left: -2.4rem;
    display: block;
    line-height: 1rem;
    font-size: 8rem;
    font-style: italic;
    font-weight: var(--font-weight-demi-bold);
    color: var(--color-accent);
  }

  .about__services :global(.title) {
    margin-block-end: 1.6rem;
    padding-inline-start: calc(var(--inline-inset) + 1.6rem);
    padding-inline-end: calc(var(--inline-inset) + 1.6rem);
  }

  .about__services > ul {
    margin-block-end: 2.4rem;
  }

  .about__services ul {
    list-style-type: circle;
    list-style-position: outside;
    font-size: var(--font-size-sm);
    padding-inline-start: calc(var(--inline-inset) + 3.2rem);
    padding-inline-end: calc(var(--inline-inset) + 1.6rem);
  }

  .about__conditions {
    background-color: var(--color-white);
    padding-block-start: 2.4rem;
    padding-block-end: 2.4rem;
  }

  .about__conditions ul {
    column-count: 2;
    column-gap: 3.2rem;
  }

  /* Testimonials */
  .testimonials {
    text-align: center;
    margin-block-end: 8rem;
  }

  .testimonials :global(.title) {
    position: relative;
    padding-inline-start: calc((100% - 60rem) / 2);
    padding-inline-end: calc((100% - 60rem) / 2);
    margin-block-end: 4rem;
  }

  .testimonials :global(.title)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    z-index: -1;
    display: block;
    width: 8rem;
    height: 8rem;
    background-color: var(--color-accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .testimonials__wrapper {
    display: grid;
    grid-template-columns: 100%;
    grid-template-rows: repeat(5, auto);
    grid-row-gap: 4rem;
    justify-items: center;
  }

  .testimonials__wrapper :global(article) {
    min-height: 4rem;
  }

  /* Blog */
  .blog > :global(.title) {
    position: relative;
    max-width: 32rem;
    margin-inline-start: 4rem;
  }

  .blog > :global(.title)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    display: block;
    width: 8rem;
    height: 8rem;
    background-color: var(--color-accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .blog__index {
    padding-block-start: 8rem;
    max-width: 50rem;
  }

  .blog__pagination {
    display: flex;
    flex-flow: column nowrap;
    align-items: flex-end;
    font-size: var(--font-size-sm);
    text-align: right;
    padding-block-start: 4rem;
  }

  .blog__pagination a {
    padding-block-end: 0.2rem;
    border-bottom: 0.2rem solid var(--color-accent);
  }

  @media screen and (max-width: 320px) {
    .about__conditions ul {
      column-count: 1;
    }
  }

  @media screen and (min-width: 768px) {
    .hero {
      justify-content: space-evenly;
      justify-items: center;
      align-items: center;
      grid-template-columns: minmax(30rem, min(45%, 55rem)) min(calc(100% - 4rem - 40%), 50rem);
      grid-template-rows: auto auto;
      grid-template-areas:
        'portrait title'
        'office-info office-info';
      grid-column-gap: 4rem;
    }

    .portrait {
      width: 100%;
      align-self: center;
    }

    .office {
      width: 90%;
    }

    section.experience {
      display: flex;
      flex-flow: row nowrap;
      justify-content: space-between;
      align-items: center;
    }

    .experience > div {
      display: flex;
      flex-flow: row nowrap;
      justify-content: space-between;
      align-items: stretch;
    }

    .work {
      flex-direction: row;
      align-items: center;
      margin-block-end: 0;
    }

    .work p {
      margin-block-start: 0;
      margin-inline-start: 1rem;
    }

    section.about {
      display: flex;
      flex-flow: row nowrap;
      justify-content: space-between;
      align-items: center;
    }

    .about__message,
    .about__services {
      flex: 1 1 0;
    }

    .about__message {
      padding-inline-end: 4rem;
    }

    .about__services :global(.title) {
      font-size: var(--font-size-base);
      padding-inline-start: 4rem;
      padding-inline-end: var(--inline-inset);
    }

    .about__services ul {
      padding-inline-start: 6rem;
      padding-inline-end: var(--inline-inset);
    }

    .testimonials {
      margin-block-end: 0;
    }

    .testimonials :global(.title) {
      margin-block-end: 10rem;
    }

    .testimonials__wrapper {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: auto auto auto auto auto auto auto;
      grid-row-gap: 6rem;
      grid-column-gap: 4rem;
    }

    .testimonials__wrapper :global(article) {
      grid-column-start: span 2;
    }

    .testimonials__wrapper :global(article):nth-child(3n + 1) {
      grid-column-start: 2;
      grid-column-end: 4;
    }

    section.blog {
      display: flex;
      flex-flow: row nowrap;
      justify-content: space-around;
      margin-block-end: 8rem;
    }

    .blog > :global(.title) {
      margin-block-start: 8rem;
      margin-inline-start: 2rem;
    }

    .blog__index {
      padding-block-start: 0;
    }

    .blog__pagination {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .blog__pagination p {
      order: 1;
      margin-block-end: 0;
    }
  }

  @media screen and (min-width: 1024px) {
    .hero {
      align-items: flex-start;
      grid-template-areas:
        'title portrait'
        'office-info portrait';
      justify-items: flex-start;
      grid-row-gap: 4rem;
    }

    section.experience {
      display: flex;
      flex-flow: row nowrap;
      justify-content: space-between;
      align-items: center;
    }

    .experience :global(.title) {
      margin-block-end: 0;
    }

    .experience > div {
      min-width: 70rem;
      margin-inline-start: 1.6rem;
    }

    .about__message {
      max-width: 50vw;
    }

    .about__services {
      max-width: 42vw;
    }
  }
</style>
