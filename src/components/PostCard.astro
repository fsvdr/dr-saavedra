---
import { capitalize, formatDate, readingTime } from '../lib/format';
import type { BlogPostSummary } from '../lib/sanity';
import Title from './Title.astro';

interface Props {
  post: BlogPostSummary;
}

const { post } = Astro.props;
const minutes = readingTime(post.plainText ?? '');
const href = `/${post.slug}`;
---

<article class="post-card" aria-label={post.title}>
  <header>
    <Title as="h3">
      <a href={href} aria-label={`${post.title} artículo completo`}>{post.title}</a>
    </Title>

    <p class="post-card__metadata">
      <time datetime={post.releaseDate}>{capitalize(formatDate(post.releaseDate))}</time>
      <span>Lectura de {minutes} minuto{minutes > 1 ? 's' : ''}</span>
    </p>
  </header>

  <p>{post.summary}</p>

  <a href={href} class="post-card__link" aria-label={`${post.title} artículo completo`}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon" focusable="false" aria-hidden="true">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
    </svg>
    <span>Leer artículo completo</span>
  </a>
</article>

<style>
  .post-card {
    width: 100%;
    padding-block-end: 4rem;
    padding-inline-start: 1.6rem;
    padding-inline-end: 1.6rem;
  }

  .post-card:not(:first-child) {
    padding-block-start: 4rem;
  }

  .post-card:not(:last-of-type) {
    border-bottom: 2px dashed var(--color-grey);
  }

  .post-card :global(.title) {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-demi-bold);
  }

  .post-card__metadata {
    font-size: var(--font-size-sm);
  }

  .post-card__metadata span {
    margin-inline-start: 1.6rem;
  }

  .post-card__link {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    font-size: var(--font-size-sm);
  }

  .post-card__link svg {
    display: inline-block;
    color: var(--color-accent);
    margin-inline-end: 0.8rem;
  }

  .post-card__link span {
    display: inline-block;
    border-bottom: 2px dotted var(--color-accent);
  }
</style>
