---
import { Image } from 'astro:assets';
import favicon from '../images/favicon.png';

interface Props {
  showInternalLinks?: boolean;
}

const { showInternalLinks = true } = Astro.props;
---

<nav class="site-nav" aria-label="Navegación principal">
  <a class="site-nav__logo" href="/" aria-label="Inicio">
    <Image src={favicon} alt="" width={24} height={24} densities={[1, 2, 3]} aria-hidden="true" />
    Dr. Saavedra
  </a>

  <ul class="site-nav__list">
    <li>
      {
        showInternalLinks && (
          <ul>
            <li>
              <a href="/#testimonios">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon" focusable="false" aria-hidden="true">
                  <circle cx="12" cy="8" r="7" />
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88" />
                </svg>
                Testimonios
              </a>
            </li>
            <li>
              <a href="/#articulos">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon" focusable="false" aria-hidden="true">
                  <path d="M12 20h9" />
                  <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                </svg>
                Artículos
              </a>
            </li>
          </ul>
        )
      }
    </li>

    <li>
      <ul>
        <li>
          <a href="https://www.linkedin.com/in/benito-saavedra-alvarado-5b9b59181">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon--offset-fix" focusable="false" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect x="2" y="9" width="4" height="12" />
              <circle cx="4" cy="4" r="2" />
            </svg>
            LinkedIn
          </a>
        </li>
        <li>
          <a href="https://twitter.com/drsaavedramx">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon" focusable="false" aria-hidden="true">
              <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
            </svg>
            Twitter
          </a>
        </li>
      </ul>
    </li>
  </ul>

  <a class="site-nav__cta" href="tel:5513227579" data-appointment-contact="primary_navigation">
    <address aria-label="Teléfono del consultorio">
      <span class="title">Agenda tu cita</span>
      <span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon" focusable="false" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        (55) 1322 7579
      </span>
    </address>
  </a>
</nav>

<script>
  const appointmentLink = document.querySelector<HTMLAnchorElement>(
    '[data-appointment-contact="primary_navigation"]',
  );
  appointmentLink?.addEventListener('click', () => {
    window.posthog?.capture('appointment_contact_initiated', {
      placement: appointmentLink.dataset.appointmentContact,
    });
  });
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    display: grid;
    grid-template:
      'logo . cta' auto
      'nav nav nav' auto
      / auto minmax(0, 1fr) auto;
    grid-row-gap: 2.4rem;
    align-items: flex-end;
    inline-size: 100%;
    padding-block-start: 1.6rem;
    padding-block-end: 1.6rem;
    padding-inline-start: calc(env(safe-area-inset-left) + 1.6rem);
    padding-inline-end: calc(env(safe-area-inset-left) + 1.6rem);
  }

  .site-nav__logo {
    grid-area: logo;
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-demi-bold);
  }

  .site-nav__logo :global(img) {
    margin-inline-end: 0.8rem;
  }

  .site-nav__list {
    grid-area: nav;
    flex: 1 1 0;
    display: flex;
    flex-flow: row nowrap;
    justify-content: space-between;
    align-items: center;
    list-style-type: none;
  }

  .site-nav__list ul {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    list-style-type: none;
  }

  .site-nav__list li:not(:last-child) {
    margin-inline-end: 1.6rem;
  }

  .site-nav__list a {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    font-size: var(--font-size-sm);
  }

  .site-nav__list a .icon {
    margin-inline-end: 0.6rem;
  }

  .site-nav__list a:hover .icon {
    stroke: var(--color-accent);
  }

  .site-nav__cta {
    grid-area: cta;
    font-size: var(--font-size-base);
    text-align: right;
  }

  .site-nav__cta .title {
    display: block;
    font-size: var(--font-size-xs);
    line-height: 100%;
  }

  .site-nav__cta span:not(.title) {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    font-weight: var(--font-weight-demi-bold);
  }

  .site-nav__cta .icon {
    color: var(--color-accent);
    margin-inline-end: 0.8rem;
  }

  @media screen and (max-width: 320px) {
    .site-nav__list a {
      flex-wrap: wrap;
      justify-content: center;
    }

    .site-nav__list .icon--offset-fix {
      margin-block-start: 0;
    }
  }

  @media screen and (min-width: 768px) {
    .site-nav {
      grid-template:
        'logo nav cta' auto
        / auto minmax(0, 1fr) auto;
      padding-inline-start: calc(env(safe-area-inset-left) + 4vw);
      padding-inline-end: calc(env(safe-area-inset-left) + 4vw);
    }

    .site-nav__list {
      padding-inline-start: 2.4rem;
      padding-inline-end: 2.4rem;
      padding-block-end: 0.1rem;
    }
  }

  @media screen and (min-width: 1600px) {
    .site-nav {
      padding-inline-start: calc((100vw - 1600px) / 2 + 4vw);
      padding-inline-end: calc((100vw - 1600px) / 2 + 4vw);
    }
  }
</style>
